# ==========================================
# CONFIGURAÇÕES DO SERVIDOR API
# ==========================================
PORT=3000

# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ==========================================
# Opções de DB_TYPE: 'sqlite', 'mysql', 'postgres'
DB_TYPE=sqlite
DB_SQLITE_PATH=./database/roleta.sqlite

# Para MySQL / PostgreSQL (Descomente e configure se for usar):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=sua_senha_aqui
# DB_NAME=roleta_db

# ==========================================
# CONFIGURAÇÕES DO AGENTE DE AUTOMAÇÃO DE NAVEGADOR (PUPPETEER)
# ==========================================
CASINO_URL=https://cassino.bet.br
CASINO_USUARIO=seu_usuario_aqui
CASINO_SENHA=sua_senha_aqui
SCRAPER_HEADLESS=false
API_ENDPOINT=http://localhost:3000/api/resultado
